{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "contractors-only",
  "compatibility_date": "2025-04-04",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "vars": {
    "VALUE_FROM_CLOUDFLARE": "Contractors Only"
  },
  "assets": {
    "directory": "./build/client"
  },
  "observability": {
    "enabled": true
  }
}
